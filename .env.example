# Copy to .env and fill in your own values. Never commit .env.

# Django
SECRET_KEY=
DEBUG=True

# Database: SQLite for local development, PostgreSQL in production
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# DigitalOcean Spaces (S3-compatible photo storage).
# Required at startup; with dummy values the site runs, but photo uploads fail
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Gmail address and app password for the contact form
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
